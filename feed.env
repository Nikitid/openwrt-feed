# Identity of the shared signed APK feed. Sourced as POSIX sh, so use plain
# VAR=value with no spaces around '='.
#
# The feed is deliberately hosted in its own repository. It used to live on a
# branch of an application repository, which meant renaming or retiring that
# application moved a URL baked into /etc/apk/repositories.d on every router.

FEED_NAME='Nikitid OpenWrt applications for OpenWrt 25.12'
FEED_REPOSITORY=Nikitid/openwrt-feed
FEED_BRANCH=feed
FEED_BASE=https://raw.githubusercontent.com/Nikitid/openwrt-feed/feed
FEED_URL=$FEED_BASE/packages.adb

# One shared publisher key signs every member package and the index. apk binds
# a key to neither a package nor a repository, so per-application keys would
# only add trust anchors to each router without adding isolation.
FEED_KEY_FILE=keys/nikitid-openwrt-release.pem
FEED_TRUST_SHA256=f27474d9261f1084350cf4ba34ecdff29e533769c36483d8dd85566e30a6a703

# Target the member applications are built for.
FEED_OPENWRT_VERSION=25.12.5
FEED_OPENWRT_TARGET=mediatek/filogic
FEED_OPENWRT_ARCH=aarch64_cortex-a53
FEED_SDK_ARCHIVE=openwrt-sdk-25.12.5-mediatek-filogic_gcc-14.3.0_musl.Linux-x86_64.tar.zst
FEED_SDK_SHA256=ff4a38a397caa2cfe1c39e18f84ddede14878221b3593c3f2c4cfe24e3ec4c25

# Member applications, one "repository:package" pair per whitespace-separated
# entry. A member without a published release is skipped, so a new application
# can be listed before it ships and an existing one never blocks the others.
FEED_MEMBERS="Nikitid/ikev2-openwrt:luci-app-ikev2-manager Nikitid/luci-layout:luci-app-overview-manager Nikitid/luci-mtproto:luci-app-mtproto-monitor Nikitid/ikev2-site-link-openwrt:luci-app-ikev2-site-link"
